font_size = 18
font_color = Color(0.78, 0.8, 0.82, 1)

[node name="Subtitle" type="Control"]
layout_mode = 3
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 120.0
offset_top = -150.0
offset_right = -120.0
offset_bottom = -24.0
