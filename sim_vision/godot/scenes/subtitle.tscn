[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/subtitle.gd" id="1"]

[sub_resource type="SystemFont" id="font_vi"]
font_names = PackedStringArray("Helvetica Neue", "Arial", "Segoe UI", "Noto Sans", "DejaVu Sans", "Sans-Serif")

[sub_resource type="StyleBoxFlat" id="panel_bg"]
